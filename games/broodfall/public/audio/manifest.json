 "voice": {
  "nar-film-1": {
   "file": "audio/nar-film-1.ogg",
   "seconds": 3.837,
   "line": "It was a quiet night, in a quiet little town."
  },
  "nar-film-2": {
   "file": "audio/nar-film-2.ogg",
   "seconds": 3.116,
   "line": "Until something came down out of the sky!"
  },
  "nar-film-5": {
   "file": "audio/nar-film-5.ogg",
   "seconds": 4.016,
   "line": "They fought it, street by street!"
  },
  "nar-film-6": {
   "file": "audio/nar-film-6.ogg",
   "seconds": 3.957,
   "line": "And it kept growing!"
  },
  "nar-wave": {
   "file": "audio/nar-wave.ogg",
   "seconds": 3.506,
   "line": "Here they come! The colony sends in its finest!"
  },
  "nar-wave-2": {
   "file": "audio/nar-wave-2.ogg",
   "seconds": 3.926,
   "line": "The pests are on the march! Clearance operations proceed on schedule!"
  },
  "nar-cleared": {
   "file": "audio/nar-cleared.ogg",
   "seconds": 3.886,
   "line": "Another wave cleared! Resources acquired for the Empire!"
  },
  "nar-royal": {
   "file": "audio/nar-royal.ogg",
   "seconds": 3.946,
   "line": "And here she comes: the royal herself takes the field!"
  },
  "nar-film-3": {
   "file": "audio/nar-film-3.ogg",
   "seconds": 3.747,
   "line": "Nobody knew what it was."
  },
  "nar-film-4": {
   "file": "audio/nar-film-4.ogg",
   "seconds": 3.756,
   "line": "It was hungry."
  }
 }
